# Copy to .env (local) or set on the host for production builds.
# Vite only exposes variables prefixed with VITE_

# Backend origin only — no trailing /api (paths already include /api/v1/...)
VITE_API_BASE_URL=http://localhost:3000

# Production example:
# VITE_API_BASE_URL=https://paryavaranprahri.com

VITE_APP_NAME=Paryavaran Prahri Admin
