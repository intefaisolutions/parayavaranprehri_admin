# Copy to .env (local) or set on the host for production builds.
# Vite only exposes variables prefixed with VITE_

# Backend API base (trailing /api/ is OK — stripped automatically)
VITE_API_URL=http://localhost:3000/api/

# Production example:
# VITE_API_URL=https://admin.paryavaranprahri.com/api/

VITE_APP_NAME=Paryavaran Prahri Admin
